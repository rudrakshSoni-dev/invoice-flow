# Postgres connection string (matches docker-compose.yml defaults)
# Host port for the docker-compose Postgres (change if 5432 is taken)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://invoiceflow:invoiceflow@localhost:5432/invoiceflow

# LLM provider used by the agent: gemini | anthropic | openai
LLM_PROVIDER=gemini
# API key for the selected provider. Never commit a real key.
LLM_API_KEY=
# Model id for the selected provider (blank = provider default)
LLM_MODEL=

# Public URL of the web app (used for links and CORS)
APP_BASE_URL=http://localhost:5173
# Max invoice upload size in megabytes
MAX_UPLOAD_MB=10
# Port the API listens on
PORT=3000
# Directory for uploaded invoice files (relative to apps/api)
UPLOAD_DIR=uploads
